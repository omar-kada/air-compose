# ---- Demo settings (edit me) ----

# Config repo AirCompose syncs from (public)
CONFIG_REPO_URL=https://github.com/omar-kada/air-compose-config

# Fixed absolute base path used for the whole demo
DEMO_BASE=/ac-demo

# Credentials typed into the UI during the recording
DEMO_USER=demo
DEMO_PASSWORD=demo-password

# Where the UI is served
UI_URL=http://localhost:5005
